<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!--Message -->
    <androidx.cardview.widget.CardView
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/card_chat_list_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        style="@style/CardStyle">

        <LinearLayout
            android:id="@+id/layout_chat_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp">
            <!-- User icon -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/text_chat_list_avatar"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center_vertical"
                android:contentDescription="User Icon"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/Circular"
                app:srcCompat="@drawable/default_pfp"/>


            <!--User name-->
            <TextView
                android:id="@+id/text_chat_list_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Global chat"
                android:textSize="20sp"
                android:textStyle="bold"
                style="@style/CardTextStyle" />

            <ImageButton
                android:id="@+id/chat_options"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                app:srcCompat="@drawable/dots_vertical"
                android:layout_gravity="center_vertical"
                android:layout_margin="2dp"
                style="@style/imagebutton" />
        </LinearLayout>

        <!--Unread bubble-->
        <ImageView
            android:id="@+id/text_chat_unread_bubble"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/unread_bubble"
            android:layout_marginStart="40dp"
            android:visibility="invisible"
            android:layout_marginTop="10dp"/>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
